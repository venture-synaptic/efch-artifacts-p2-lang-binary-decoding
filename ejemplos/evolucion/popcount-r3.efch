; EXP-002, caso desfavorable: popcount(x) definido como 64 - popcount(not x).
; Equivalente a la definición original, pero difícil de demostrar para Z3.
; Recuento de bits a 1 en un entero de 64 bits.
; Clásico de la superoptimización: la definición suma bit a bit y la
; implementación interesa que no lo haga.

(efch 0.1

  (computation popcount64
    (doc "Número de bits a 1 de x.")
    (input x (bv 64))
    (output (bv 8))
    (semantics
      (sub 64 (reduce add i 0 64 (trunc 8 (and (lshr (not x) i) 1)))))
    (workload
      (seeds 20261020 1 2)
      (count 10000)
      (input x (bits 64)))
    (objective (minimize time))
    (budget (llm-calls 4) (llm-usd 1.5) (smt-seconds 30)))

  (property cota
    (forall ((x (bv 64)))
      (ule (call popcount64 x) 64)))


  (baseline-c "../popcount.baseline.c"))
