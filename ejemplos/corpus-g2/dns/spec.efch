; Nombre de host (RFC 1123 §2.1, RFC 952) en formato de cable DNS (RFC 1035 §3.1 y §4.1.4). EXP-007.
(efch 0.1
  (computation dns-ldh
    (doc "Letra ASCII de cualquier caja, dígito o guion.")
    (input c (bv 8))
    (output bool)
    (semantics (any (all (uge (or c #x20) #x61) (ule (or c #x20) #x7a))
                    (all (uge c #x30) (ule c #x39))
                    (eq c #x2d))))

  (computation dns-label-ok
    (doc "En p empieza una etiqueta válida: longitud 1–63, cabe en el búfer, LDH y sin guion en los extremos.")
    (input b (bytes 64))
    (input p (bv 16))
    (output bool)
    (semantics
      (all (ult p (len b))
           (uge (byte b p) 1)
           (ule (byte b p) 63)
           (ult (add p (zext 16 (byte b p))) (len b))
           (ne (byte b (add p 1)) #x2d)
           (ne (byte b (add p (zext 16 (byte b p)))) #x2d)
           (reduce all j 1 64
             (any (ugt (bv 16 j) (zext 16 (byte b p)))
                  (call dns-ldh (byte b (add p j))))))))

  (computation dns-step
    (doc "Estado: etiquetas en el byte alto, posición en el bajo. Avanza una etiqueta si la hay; si no, queda fijo.")
    (input b (bytes 64))
    (input s (bv 16))
    (output (bv 16))
    (semantics
      (let ((p (and s #xff)))
        (ite (call dns-label-ok b p)
             (or (shl (add (lshr s 8) 1) 8) (add p 1 (zext 16 (byte b p))))
             s))))

  (computation dns-hostname-wire
    (doc "Recorre como mucho 32 etiquetas desde 0 (cada una ocupa al menos 2 bytes de 64) y clasifica el octeto donde para: 0 = fin, 11xxxxxx = puntero, otro = error.")
    (input b (bytes 64))
    (output (option (bv 8) (bv 8) (bv 16)))          ; consumidos, etiquetas, puntero (FFFF si no hay)
    (semantics
      (let ((s1 (call dns-step b (bv 16 0)))
            (s2 (call dns-step b s1))
            (s3 (call dns-step b s2))
            (s4 (call dns-step b s3))
            (s5 (call dns-step b s4))
            (s6 (call dns-step b s5))
            (s7 (call dns-step b s6))
            (s8 (call dns-step b s7))
            (s9 (call dns-step b s8))
            (s10 (call dns-step b s9))
            (s11 (call dns-step b s10))
            (s12 (call dns-step b s11))
            (s13 (call dns-step b s12))
            (s14 (call dns-step b s13))
            (s15 (call dns-step b s14))
            (s16 (call dns-step b s15))
            (s17 (call dns-step b s16))
            (s18 (call dns-step b s17))
            (s19 (call dns-step b s18))
            (s20 (call dns-step b s19))
            (s21 (call dns-step b s20))
            (s22 (call dns-step b s21))
            (s23 (call dns-step b s22))
            (s24 (call dns-step b s23))
            (s25 (call dns-step b s24))
            (s26 (call dns-step b s25))
            (s27 (call dns-step b s26))
            (s28 (call dns-step b s27))
            (s29 (call dns-step b s28))
            (s30 (call dns-step b s29))
            (s31 (call dns-step b s30))
            (s32 (call dns-step b s31)))
        (let ((p (and s32 #xff)) (n (trunc 8 (lshr s32 8))))
          (ite (uge p (len b))
               none
               (let ((l (byte b p)))
                 (ite (eq l 0)
                      (some (trunc 8 (add p 1)) n #xffff)
                      (ite (all (eq (and l #xc0) #xc0) (ult (add p 1) (len b)))
                           (some (trunc 8 (add p 2)) n
                                 (or (shl (zext 16 (and l #x3f)) 8) (zext 16 (byte b (add p 1)))))
                           none)))))))
    (workload (seeds 20261021 1 2) (count 10000) (input b (random-bytes 1 64)))
    (objective (minimize time))
    (budget (llm-calls 0) (smt-seconds 120))))
